// Inter (SIL Open Font License, see fonts/Inter-OFL.txt). Fonts must be
// imported explicitly: this crate has no "systemfonts" feature, so without it
// glyph rasterization silently falls back to an arbitrary build-machine font.
import "./fonts/Inter.ttf";

// One root component with `if` blocks per screen: `platform::EspPlatform`
// always hands back the same `MinimalSoftwareWindow` (see platform.rs).
// The PIN pad is shared between "set PIN" and "unlock" via `pin-title`/`pin-error`.

// Hex values mirror `corisco-android-app/src/theme.ts` (including the orange accent).
// Only Blockstream Jade's layout was wanted as inspiration, not its colors.
global Theme {
    out property <color> bg: #0b0b0f;
    out property <color> surface: #17171d;
    out property <color> border: #2a2a33;
    out property <color> text-primary: #f5f5f7;
    out property <color> text-secondary: #9b9ba6;
    out property <color> text-muted: #6b6b76;
    out property <color> text-disabled: #4a4a52;
    out property <color> accent: #ff5a1f;
    out property <color> accent-pressed: #cc4819;
    out property <color> accent-text: #1a1305;
    out property <color> error: #ff6b6b;
    out property <color> error-pressed: #c85252;
    out property <color> error-text: #1a0505;
    out property <color> success: #4ade80;
    out property <color> pressed: #2a2a33;

    out property <length> button-height: 48px;
    out property <length> header-height: 36px;
}

// Square, edge-to-edge buttons: no radius, no outer margin, so a row of them
// can sit flush against the screen border.
component PrimaryButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    height: Theme.button-height;
    background: ta.pressed ? Theme.accent-pressed : Theme.accent;
    ta := TouchArea { clicked => { root.clicked(); } }
    Text {
        text: root.text;
        color: Theme.accent-text;
        font-size: 16px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
}

component OutlineButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    height: Theme.button-height;
    background: ta.pressed ? Theme.pressed : Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    ta := TouchArea { clicked => { root.clicked(); } }
    Text {
        text: root.text;
        color: Theme.text-primary;
        font-size: 16px;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
}

component DangerButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    height: Theme.button-height;
    background: ta.pressed ? Theme.error-pressed : Theme.error;
    ta := TouchArea { clicked => { root.clicked(); } }
    Text {
        text: root.text;
        color: Theme.error-text;
        font-size: 16px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
}

// Colorized monochrome SVGs from ./icons/; the source stroke color is ignored.
component Icon {
    in property <image> source;
    in property <brush> color: Theme.text-primary;
    in property <length> size: 16px;
    Image {
        source: root.source;
        colorize: root.color;
        width: root.size;
        height: root.size;
    }
}

component Header inherits Rectangle {
    in property <string> title;
    in property <bool> show-back: false;
    callback back-clicked();
    height: Theme.header-height;
    background: Theme.surface;
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
    if root.show-back: Rectangle {
        x: 0px;
        width: Theme.header-height + 8px;
        background: back-ta.pressed ? Theme.pressed : transparent;
        border-width: 1px;
        border-color: Theme.border;
        back-ta := TouchArea { clicked => { root.back-clicked(); } }
        Icon {
            source: @image-url("./icons/arrow-left.svg");
            size: 20px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
    Text {
        text: root.title;
        color: Theme.text-primary;
        font-size: 18px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component Key inherits Rectangle {
    in property <string> label;
    callback clicked();
    background: ta.pressed ? Theme.pressed : Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    ta := TouchArea { clicked => { root.clicked(); } }
    Text {
        text: root.label;
        color: Theme.text-primary;
        font-size: 22px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component AppWindow inherits Window {
    // Must stay in sync with `display::WIDTH`/`HEIGHT` in src/display.rs.
    width: 320px;
    height: 170px;
    background: Theme.bg;
    default-font-family: "Inter";

    // 0=Welcome 1=Mnemonic 2=Pin 3=Home 4=SignConfirm 5=Wiped 6=Working
    // 7=Pairing 8=WordCount 9=WordEntry 10=FactoryResetConfirm 11=Settings
    // 12=DisableConfirmationConfirm
    in-out property <int> screen: 0;

    // SecurityIOCap::DisplayOnly: the passkey must be shown here (ble.rs's on_passkey_request).
    in property <string> pairing-passkey: "";

    // Shown for at least one real frame before slow crypto calls, which block the render loop.
    in property <string> working-label: "Working...";

    // Paginated at 12 words/page rather than scrollable: a missed word here is
    // a much worse failure than on any other screen.
    in property <[string]> mnemonic-words: [];
    in property <int> mnemonic-page: 0;
    in property <int> mnemonic-page-count: 1;

    in property <string> pin-title: "Enter PIN";
    in property <int> pin-entered-count: 0;
    in property <int> pin-max-length: 6;
    in property <string> pin-error: "";

    in property <string> identity-pubkey-short: "";
    // A peripheral can't advertise while connected, so two states suffice.
    in property <bool> ble-connected: false;

    in property <string> sign-leaf-id-short: "";
    in property <string> sign-fingerprint: "";
    // App-asserted, not verified against the FROST message (the wire protocol
    // only carries a sighash). Empty when the app didn't supply them.
    in property <string> sign-amount-sats: "";
    in property <string> sign-destination: "";

    in property <string> wiped-reason: "";

    // Mirrors `ble.rs`'s `Signer.require_confirmation`. Turning it off is a
    // security-posture change, hence the separate confirm screen (12).
    in property <bool> require-confirmation: true;

    in property <string> word-entry-progress: "";
    in property <string> word-entry-prefix: "";
    in property <[string]> word-suggestions: [];
    // 26 entries, a-z; false when no candidate word continues the prefix with that letter.
    in property <[bool]> letter-enabled: [];
    in property <string> word-entry-error: "";

    callback create-pressed();
    callback recover-pressed();
    callback word-count-pressed(int);
    callback mnemonic-continue-pressed();
    callback mnemonic-next-page-pressed();
    callback mnemonic-prev-page-pressed();
    callback pin-digit-pressed(int);
    callback pin-backspace-pressed();
    callback sign-accept-pressed();
    callback sign-decline-pressed();
    callback letter-pressed(int);
    callback suggestion-pressed(int);
    callback word-entry-backspace-pressed();
    callback factory-reset-pressed();
    callback factory-reset-confirm-pressed();
    callback factory-reset-cancel-pressed();
    callback settings-pressed();
    callback settings-back-pressed();
    callback require-confirmation-toggle-pressed();
    callback disable-confirmation-confirm-pressed();
    callback disable-confirmation-cancel-pressed();

    if root.screen == 0: VerticalLayout {
        VerticalLayout {
            alignment: center;
            spacing: 8px;
            HorizontalLayout {
                alignment: center;
                spacing: 10px;
                Icon { source: @image-url("./icons/key.svg"); color: Theme.accent; size: 26px; }
                Text {
                    text: "Corisco Wallet";
                    color: Theme.accent;
                    font-size: 24px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
            Text {
                text: "Your keys never leave this device.";
                color: Theme.text-secondary;
                font-size: 14px;
                horizontal-alignment: center;
            }
        }
        PrimaryButton {
            text: "Create new wallet";
            clicked => { root.create-pressed(); }
        }
        OutlineButton {
            text: "Recover wallet";
            clicked => { root.recover-pressed(); }
        }
    }

    // Pre-numbered in Rust (`ui/mod.rs`'s `words_model`), so plain indexing suffices here.
    if root.screen == 1: VerticalLayout {
        Header {
            title: "Recovery phrase " + (root.mnemonic-page + 1) + "/" + root.mnemonic-page-count;
        }
        GridLayout {
            padding-left: 8px;
            padding-right: 8px;
            for r in 4: Row {
                for c in 3: Text {
                    text: root.mnemonic-words[root.mnemonic-page * 12 + r * 3 + c];
                    color: Theme.text-primary;
                    font-size: 16px;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                }
            }
        }
        HorizontalLayout {
            if root.mnemonic-page > 0: OutlineButton {
                text: "Back";
                clicked => { root.mnemonic-prev-page-pressed(); }
            }
            if root.mnemonic-page + 1 < root.mnemonic-page-count: PrimaryButton {
                text: "Next";
                clicked => { root.mnemonic-next-page-pressed(); }
            }
            if root.mnemonic-page + 1 >= root.mnemonic-page-count: PrimaryButton {
                text: "I've written this down";
                clicked => { root.mnemonic-continue-pressed(); }
            }
        }
    }

    // Title/dots/error sit beside the keypad: stacked above it they overflow 170px.
    if root.screen == 2: HorizontalLayout {
        VerticalLayout {
            alignment: center;
            width: 110px;
            padding: 8px;
            spacing: 8px;
            Icon { source: @image-url("./icons/lock.svg"); color: Theme.accent; size: 26px; }
            Text {
                text: root.pin-title;
                color: Theme.text-primary;
                font-size: 16px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: center;
                spacing: 6px;
                for i in root.pin-max-length: Rectangle {
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: i < root.pin-entered-count ? Theme.accent : Theme.border;
                }
            }
            Text {
                text: root.pin-error;
                color: Theme.error;
                font-size: 12px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
        GridLayout {
            Row {
                for n in 3: Key { label: n + 1; clicked => { root.pin-digit-pressed(n + 1); } }
            }
            Row {
                for n in 3: Key { label: n + 4; clicked => { root.pin-digit-pressed(n + 4); } }
            }
            Row {
                for n in 3: Key { label: n + 7; clicked => { root.pin-digit-pressed(n + 7); } }
            }
            Row {
                Rectangle { }
                Key { label: "0"; clicked => { root.pin-digit-pressed(0); } }
                Key { label: "<"; clicked => { root.pin-backspace-pressed(); } }
            }
        }
    }

    if root.screen == 3: VerticalLayout {
        VerticalLayout {
            alignment: center;
            padding: 8px;
            spacing: 8px;
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                Icon { source: @image-url("./icons/check.svg"); color: Theme.success; size: 22px; }
                Text {
                    text: "Ready";
                    color: Theme.success;
                    font-size: 24px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
            HorizontalLayout {
                alignment: center;
                spacing: 6px;
                Icon {
                    source: @image-url("./icons/bluetooth.svg");
                    color: root.ble-connected ? Theme.success : Theme.accent;
                    size: 16px;
                }
                Text {
                    text: root.ble-connected ? "Connected" : "Advertising";
                    color: Theme.text-secondary;
                    font-size: 15px;
                    vertical-alignment: center;
                }
            }
            Text {
                text: root.identity-pubkey-short;
                color: Theme.text-muted;
                font-size: 12px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
        OutlineButton {
            text: "Settings";
            clicked => { root.settings-pressed(); }
        }
    }

    if root.screen == 4: VerticalLayout {
        VerticalLayout {
            alignment: center;
            padding: 8px;
            spacing: 6px;
            Text {
                text: root.sign-amount-sats == "" ? "Confirm signature" : "Send " + root.sign-amount-sats + " sats";
                color: Theme.accent;
                font-size: 20px;
                font-weight: 700;
                horizontal-alignment: center;
            }
            if root.sign-amount-sats != "": Text {
                text: root.sign-destination == "" ? "" : "to " + root.sign-destination;
                color: Theme.text-secondary;
                font-size: 14px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            // Several leaves in one payment produce one prompt each; without
            // this they look identical (see ble-hardware-signer.ts's `withSpendContext`).
            if root.sign-amount-sats != "": Text {
                text: "leaf " + root.sign-leaf-id-short;
                color: Theme.text-muted;
                font-size: 12px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            if root.sign-amount-sats == "": Text {
                text: "leaf " + root.sign-leaf-id-short;
                color: Theme.text-secondary;
                font-size: 14px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            if root.sign-amount-sats == "": Text {
                text: root.sign-fingerprint;
                color: Theme.text-muted;
                font-size: 12px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
        HorizontalLayout {
            PrimaryButton {
                text: "Accept";
                clicked => { root.sign-accept-pressed(); }
            }
            OutlineButton {
                text: "Decline";
                clicked => { root.sign-decline-pressed(); }
            }
        }
    }

    if root.screen == 5: VerticalLayout {
        alignment: center;
        padding: 12px;
        spacing: 10px;
        Text {
            text: "Wiped";
            color: Theme.error;
            font-size: 24px;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: root.wiped-reason;
            color: Theme.text-secondary;
            font-size: 14px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Text {
            text: "Restart to create a new wallet.";
            color: Theme.text-muted;
            font-size: 13px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }

    if root.screen == 6: VerticalLayout {
        alignment: center;
        padding: 12px;
        Text {
            text: root.working-label;
            color: Theme.accent;
            font-size: 20px;
            horizontal-alignment: center;
        }
    }

    if root.screen == 7: VerticalLayout {
        alignment: center;
        padding: 12px;
        spacing: 10px;
        Text {
            text: "Pairing request";
            color: Theme.text-primary;
            font-size: 18px;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: "Enter this code on your phone:";
            color: Theme.text-secondary;
            font-size: 14px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Text {
            text: root.pairing-passkey;
            color: Theme.accent;
            font-size: 40px;
            font-weight: 700;
            horizontal-alignment: center;
        }
    }

    // Full-width rows rather than `PrimaryButton`s here: the error line appears
    // above them after a failed recovery attempt, so they must not claim extra height.
    if root.screen == 8: VerticalLayout {
        Header { title: "Recovery phrase length"; }
        if root.word-entry-error != "": Text {
            text: root.word-entry-error;
            color: Theme.error;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
        }
        Rectangle { }
        PrimaryButton {
            text: "12 words";
            clicked => { root.word-count-pressed(12); }
        }
        OutlineButton {
            text: "24 words";
            clicked => { root.word-count-pressed(24); }
        }
    }

    // 3 rows x 9 columns = 27 cells for 26 letters; the extra cell is hidden
    // so the grid stays rectangular. Taller layouts overflow the 170px screen.
    property <[string]> letter-labels: ["a","b","c","d","e","f","g","h","i","j","k","l","m","n","o","p","q","r","s","t","u","v","w","x","y","z"];

    if root.screen == 9: VerticalLayout {
        HorizontalLayout {
            height: 32px;
            Text {
                text: root.word-entry-progress;
                color: Theme.text-secondary;
                font-size: 13px;
                vertical-alignment: center;
                horizontal-alignment: center;
                width: 60px;
            }
            Text {
                text: root.word-entry-prefix == "" ? "_" : root.word-entry-prefix;
                color: Theme.accent;
                font-size: 20px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Rectangle {
                width: 64px;
                background: del-ta.pressed ? Theme.pressed : Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                del-ta := TouchArea { clicked => { root.word-entry-backspace-pressed(); } }
                Text { text: "Del"; color: Theme.text-primary; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        if root.word-entry-error != "": Text {
            text: root.word-entry-error;
            color: Theme.error;
            font-size: 11px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        HorizontalLayout {
            height: 28px;
            for i in root.word-suggestions.length: Rectangle {
                background: sug-ta.pressed ? Theme.accent-pressed : Theme.accent;
                sug-ta := TouchArea { clicked => { root.suggestion-pressed(i); } }
                Text {
                    text: root.word-suggestions[i];
                    color: Theme.accent-text;
                    font-size: 14px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        GridLayout {
            for r in 3: Row {
                for c in 9: Rectangle {
                    visible: r * 9 + c < 26;
                    background: key-ta.pressed && root.letter-enabled[r * 9 + c] ? Theme.pressed : Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    key-ta := TouchArea {
                        clicked => { if (root.letter-enabled[r * 9 + c]) { root.letter-pressed(r * 9 + c); } }
                    }
                    Text {
                        text: root.letter-labels[r * 9 + c];
                        color: root.letter-enabled[r * 9 + c] ? Theme.text-primary : Theme.text-disabled;
                        font-size: 17px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    if root.screen == 10: VerticalLayout {
        VerticalLayout {
            alignment: center;
            padding: 12px;
            spacing: 8px;
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                Icon { source: @image-url("./icons/warning.svg"); color: Theme.error; size: 22px; }
                Text {
                    text: "Factory reset";
                    color: Theme.error;
                    font-size: 20px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
            Text {
                text: "This erases the wallet on this device. Make sure you have your recovery phrase written down.";
                color: Theme.text-secondary;
                font-size: 14px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
        HorizontalLayout {
            DangerButton {
                text: "Erase and reset";
                clicked => { root.factory-reset-confirm-pressed(); }
            }
            OutlineButton {
                text: "Cancel";
                clicked => { root.factory-reset-cancel-pressed(); }
            }
        }
    }

    if root.screen == 11: VerticalLayout {
        Header {
            title: "Settings";
            show-back: true;
            back-clicked => { root.settings-back-pressed(); }
        }
        Rectangle {
            height: Theme.button-height;
            background: toggle-ta.pressed ? Theme.pressed : Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            toggle-ta := TouchArea { clicked => { root.require-confirmation-toggle-pressed(); } }
            Text {
                text: "Require confirmation: " + (root.require-confirmation ? "ON" : "OFF");
                color: root.require-confirmation ? Theme.success : Theme.error;
                font-size: 16px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        if !root.require-confirmation: Text {
            text: "Transactions will be signed automatically, with no prompt on this device.";
            color: Theme.error;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
        }
        Rectangle { }
        OutlineButton {
            text: "Factory reset";
            clicked => { root.factory-reset-pressed(); }
        }
    }

    // Turning confirmation back ON (main.rs) needs no such gate.
    if root.screen == 12: VerticalLayout {
        VerticalLayout {
            alignment: center;
            padding: 12px;
            spacing: 8px;
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                Icon { source: @image-url("./icons/warning.svg"); color: Theme.error; size: 22px; }
                Text {
                    text: "Disable confirmation?";
                    color: Theme.error;
                    font-size: 20px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
            Text {
                text: "The device will sign transactions automatically, without asking you to approve them here.";
                color: Theme.text-secondary;
                font-size: 14px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
        HorizontalLayout {
            DangerButton {
                text: "Disable";
                clicked => { root.disable-confirmation-confirm-pressed(); }
            }
            OutlineButton {
                text: "Cancel";
                clicked => { root.disable-confirmation-cancel-pressed(); }
            }
        }
    }
}
